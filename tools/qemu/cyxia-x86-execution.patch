From: CyxiaOS Prototype <cyxiaos@example.invalid>
Subject: [PATCH] x86: expose fail-closed translated-TB execution nanoseconds

Standalone patch against QEMU v10.2.2 f8ed81651e61d9c2166df6121ce2af0f44f06b3e.
Does not include or alter the historical Arm PMU patch. Execution includes only
translated guest code and synchronous helpers. CPUID ABI 1 identifies two
readonly project MSRs: per-vCPU execution ns and separate shared QEMU virtual
monotonic ns. Require healthy MTTCG with no icount; latch all clock faults.
No live migration support. cyxia-exec-fail-after-ns is explicit fault injection.

diff --git a/include/hw/core/cpu.h b/include/hw/core/cpu.h
--- a/include/hw/core/cpu.h
+++ b/include/hw/core/cpu.h
@@ -585,6 +585,14 @@
     /* track IOMMUs whose translations we've cached in the TCG TLB */
     GArray *iommu_notifiers;
 
+    /* Cyxia x86 prototype: translated-TB thread CPU nanoseconds, not migrated. */
+    uint64_t cyxia_exec_ns;
+    uint64_t cyxia_exec_started_ns;
+    uint64_t cyxia_exec_last_clock_ns;
+    bool cyxia_exec_active;
+    bool cyxia_exec_initialized;
+    bool cyxia_exec_failed;
+
     /*
      * MUST BE LAST in order to minimize the displacement to CPUArchState.
      */
@@ -628,6 +636,10 @@
     QTAILQ_FOREACH_SAFE_RCU(cpu, &cpus_queue, node, next_cpu)
 
 extern __thread CPUState *current_cpu;
+
+void cyxia_cpu_exec_start(CPUState *cpu);
+void cyxia_cpu_exec_stop(CPUState *cpu);
+bool cyxia_cpu_exec_time_ns(CPUState *cpu, uint64_t *value);
 
 /**
  * cpu_paging_enabled:
diff --git a/cpu-common.c b/cpu-common.c
--- a/cpu-common.c
+++ b/cpu-common.c
@@ -122,6 +122,90 @@
 
 /* current CPU in the current thread. It is only valid inside cpu_exec() */
 __thread CPUState *current_cpu;
+
+/* BEGIN CYXIA_EXEC_CLOCK: extracted unchanged by the focused fault harness. */
+static bool cyxia_thread_cpu_time_ns(uint64_t *value)
+{
+#ifdef CLOCK_THREAD_CPUTIME_ID
+    struct timespec ts;
+
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0 &&
+        ts.tv_sec >= 0 && ts.tv_nsec >= 0 && ts.tv_nsec < 1000000000 &&
+        (uint64_t)ts.tv_sec <=
+            (UINT64_MAX - (uint64_t)ts.tv_nsec) / 1000000000ULL) {
+        *value = (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+        return true;
+    }
+#endif
+    return false;
+}
+
+static bool cyxia_exec_clock_read(CPUState *cpu, uint64_t *now)
+{
+    if (cpu->cyxia_exec_failed) {
+        return false;
+    }
+    if (!cyxia_thread_cpu_time_ns(now) ||
+        (cpu->cyxia_exec_initialized && *now < cpu->cyxia_exec_last_clock_ns)) {
+        cpu->cyxia_exec_failed = true;
+        return false;
+    }
+    cpu->cyxia_exec_initialized = true;
+    cpu->cyxia_exec_last_clock_ns = *now;
+    return true;
+}
+
+static bool cyxia_exec_sum(CPUState *cpu, uint64_t delta, uint64_t *total)
+{
+    if (UINT64_MAX - cpu->cyxia_exec_ns < delta) {
+        cpu->cyxia_exec_failed = true;
+        return false;
+    }
+    *total = cpu->cyxia_exec_ns + delta;
+    return true;
+}
+
+void cyxia_cpu_exec_start(CPUState *cpu)
+{
+    uint64_t now;
+
+    if (cpu->cyxia_exec_active) {
+        cpu->cyxia_exec_failed = true;
+        return;
+    }
+    if (!cyxia_exec_clock_read(cpu, &now)) {
+        return;
+    }
+    cpu->cyxia_exec_started_ns = now;
+    cpu->cyxia_exec_active = true;
+}
+
+void cyxia_cpu_exec_stop(CPUState *cpu)
+{
+    uint64_t now, total;
+
+    if (!cpu->cyxia_exec_active) {
+        return;
+    }
+    cpu->cyxia_exec_active = false;
+    if (cyxia_exec_clock_read(cpu, &now) &&
+        cyxia_exec_sum(cpu, now - cpu->cyxia_exec_started_ns, &total)) {
+        cpu->cyxia_exec_ns = total;
+    }
+}
+
+bool cyxia_cpu_exec_time_ns(CPUState *cpu, uint64_t *value)
+{
+    uint64_t now;
+
+    /* Guest reads are valid only inside the owning vCPU's current TB. */
+    if (current_cpu != cpu || !cpu->cyxia_exec_active ||
+        !cpu->cyxia_exec_initialized || !cyxia_exec_clock_read(cpu, &now)) {
+        return false;
+    }
+    return cyxia_exec_sum(cpu, now - cpu->cyxia_exec_started_ns, value);
+}
+/* END CYXIA_EXEC_CLOCK */
 
 struct qemu_work_item {
     QSIMPLEQ_ENTRY(qemu_work_item) node;
