+bool cyxia_x86_clock_available(CPUX86State *env)
+{
+#if defined(CONFIG_TCG) && !defined(CONFIG_USER_ONLY)
+    X86CPU *cpu = env_archcpu(env);
+    CPUState *cs = env_cpu(env);
+    uint64_t value;
+
+    if (tcg_enabled() && cpu->expose_tcg && qemu_tcg_mttcg_enabled() &&
+        !icount_enabled() && cyxia_cpu_exec_time_ns(cs, &value)) {
+        if (value >= cpu->cyxia_exec_fail_after_ns) {
+            cs->cyxia_exec_failed = true;
+            return false;
+        }
+        return true;
+    }
+#endif
+    return false;
+}
+
 void cpu_x86_cpuid(CPUX86State *env, uint32_t index, uint32_t count,
                    uint32_t *eax, uint32_t *ebx,
                    uint32_t *ecx, uint32_t *edx)
@@ -8333,6 +8354,12 @@
         *ebx = 0;
         *ecx = 0;
         *edx = 0;
+        if (cyxia_x86_clock_available(env)) {
+            *eax = CYXIA_CLOCK_MAGIC;
+            *ebx = CYXIA_CLOCK_VERSION_FLAGS;
+            *ecx = MSR_CYXIA_EXEC_NS;
+            *edx = CYXIA_CLOCK_HZ;
+        }
         break;
     case 0x80000000:
         *eax = env->cpuid_xlevel;
@@ -10022,6 +10049,8 @@
                      false),
     DEFINE_PROP_BOOL("vmware-cpuid-freq", X86CPU, vmware_cpuid_freq, true),
