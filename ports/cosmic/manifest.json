  "required_work": [
    {
      "id": "backend-feature-port",
      "scope": "build",
      "detail": "Separate unconditional Smithay KMS/GBM/udev/libinput/libseat/Vulkan and renderer-multi source dependencies; --no-default-features only removes systemd defaults."
    },
    {
      "id": "real-egl-loader",
      "scope": "build-runtime",
      "detail": "Provide real EGL/GLES and its driver. Smithay loads libEGL.so.1 via libloading; current static musl profile needs a real dynamic loader or explicit static EGL binding port, including winit/Xlib loading."
    },
    {
      "id": "rust-std-guest",
      "scope": "runtime",
      "detail": "The bounded std startup/TLS/thread/futex/allocator subset passed cosmic-bootstrap-r3. Validate the actual COSMIC dependency closure and remaining runtime APIs separately; see docs/implementation/rust-std-foundation.md."
    },
    {
      "id": "wayland-fd-shm",
      "scope": "runtime",
      "detail": "Guest-verify Unix SCM_RIGHTS ownership/truncation, shared file-backed buffers, mmap lifecycle, peer credentials and readiness. A byte-only roundtrip is not wl_shm support."
    },
    {
      "id": "event-loop",
      "scope": "runtime",
      "detail": "Level/oneshot epoll and stream-message gates passed cosmic-bootstrap-r3. CLOCK_MONOTONIC timerfd with counted periodic reads, shared OFDs and blocking/reuse checks passed cosmic-timer-r2. Edge-triggering, nested epoll, clock/cancellation extensions and complete calloop/Tokio requirements remain; see docs/implementation/timerfd.md."
    },
    {
      "id": "shader-present",
      "scope": "runtime",
      "detail": "Create a real EGL/GLES context, compile upstream shaders, render/read back exact pixels and present through the guest Xorg before claiming the software path works."
    },
    {
      "id": "session-services",
      "scope": "full-session",
      "detail": "Port and validate cosmic-session/panel/applets/config/service/process spawning and D-Bus services separately; a compositor or one toolkit window is not the full desktop."
    },
    {
      "id": "resource-budget",
      "scope": "runtime",
      "detail": "Measure final ELF, resident memory, threads, process/FD slots and rendering cost against CyxiaOS admission budgets; do not assume the existing desktop allocation is sufficient."
    }
  ],
