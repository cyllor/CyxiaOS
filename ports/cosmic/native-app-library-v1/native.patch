@@ -0,0 +1,54 @@
+use cosmic_settings_config::shortcuts::{self, action::System};
+use launch_pad::native_child::NativeChild;
+use std::borrow::Cow;
+use tokio::io::{self, AsyncRead};
+
+pub async fn spawn(exec: &str, environment: Vec<(String, String)>, app_id: &str, terminal: bool) {
+    let command = if terminal {
+        let terminal = shortcuts::context()
+            .ok()
+            .and_then(|config| {
+                shortcuts::system_actions(&config)
+                    .get(&System::Terminal)
+                    .cloned()
+            })
+            .unwrap_or_else(|| "cosmic-term".to_string());
+        Cow::Owned(format!("{terminal} -e {exec}"))
+    } else {
+        Cow::Borrowed(exec)
+    };
+    let mut fields = shlex::Shlex::new(&command);
+    let Some(executable) = fields
+        .next()
+        .filter(|name| !name.is_empty() && !name.contains('='))
+    else {
+        log::warn!("Invalid desktop command for {app_id}");
+        return;
+    };
+    // Match libcosmic's handling of field codes for launches without files.
+    let arguments = fields
+        .by_ref()
+        .filter(|field| !field.starts_with('%'))
+        .collect::<Vec<_>>();
+    if fields.had_error {
+        log::warn!("Invalid desktop command for {app_id}");
+        return;
+    }
+    let mut child = match NativeChild::spawn(&executable, &arguments, &environment, &[]) {
+        Ok(child) => child,
+        Err(error) => {
+            log::error!("Could not launch {app_id}: {error}");
+            return;
+        }
+    };
+    let stdout = child.stdout.take().expect("native child stdout");
+    let stderr = child.stderr.take().expect("native child stderr");
+    let (result, _, _) = tokio::join!(child.wait(), drain(stdout), drain(stderr));
+    if let Err(error) = result {
+        log::warn!("Could not collect {app_id}: {error}");
+    }
+}
+
+async fn drain(mut stream: impl AsyncRead + Unpin) -> io::Result<u64> {
+    io::copy(&mut stream, &mut io::sink()).await
+}
