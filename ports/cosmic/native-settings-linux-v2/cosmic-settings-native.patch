diff --git a/native-deps/cosmic-comp-config/Cargo.toml b/native-deps/cosmic-comp-config/Cargo.toml
new file mode 100644
--- /dev/null
+++ b/native-deps/cosmic-comp-config/Cargo.toml
@@ -0,0 +1,22 @@
+[package]
+name = "cosmic-comp-config"
+version = "1.0.0"
+edition = "2024"
+
+[dependencies]
+cosmic-config = { git = "https://github.com/pop-os/libcosmic/" }
+cosmic-randr-shell = { git = "https://github.com/pop-os/cosmic-randr/", rev = "6e8e795970fa06d434af22775e415b517f7552d3", optional = true }
+input = { version = "0.10.0", optional = true }
+libdisplay-info = { version = "0.3.0", optional = true }
+serde = { version = "1", features = ["derive"] }
+ron = { version = "0.12", optional = true }
+tracing = { version = "0.1.44", features = [
+    "max_level_debug",
+    "release_max_level_info",
+], optional = true }
+
+[features]
+default = ["libinput"]
+libinput = ["dep:input"]
+output = ["ron", "tracing"]
+randr = ["cosmic-randr-shell", "output"]
