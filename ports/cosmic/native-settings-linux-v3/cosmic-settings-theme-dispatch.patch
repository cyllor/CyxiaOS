+// Theme parsing and export perform synchronous filesystem/CPU work. Keep them
+// off the current-thread Tokio executor that also serves real D-Bus requests.
+// Every caller awaits completion before processing another theme event. Do not
+// race cancellation against this JoinHandle: an unfinished blocking task must
+// not keep writing after watch_theme returns and main resets the exports.
+async fn run_theme_work<F>(phase: &'static str, work: F) -> anyhow::Result<()>
+where
+    F: FnOnce() + Send + 'static,
+{
+    tokio::task::spawn_blocking(move || {
+        eprintln!("cosmic-settings-daemon: theme work begin phase={phase}");
+        work();
+        eprintln!("cosmic-settings-daemon: theme work end phase={phase}");
+    })
+    .await?;
+    Ok(())
+}
