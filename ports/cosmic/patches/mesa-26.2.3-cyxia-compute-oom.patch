+
+#ifdef CYXIA_COMPUTE_OOM
+enum pipe_error
+tgsi_exec_machine_bind_compute_shader_checked(
+   struct tgsi_exec_machine *mach, const struct tgsi_token *tokens,
+   struct tgsi_sampler *sampler, struct tgsi_image *image,
+   struct tgsi_buffer *buffer)
+{
+   struct tgsi_parse_context parse;
+   struct tgsi_full_declaration *declarations = NULL;
+   struct tgsi_full_instruction *instructions = NULL;
+   float4 *imms = NULL;
+   unsigned counts[3] = {0};
+   unsigned used[3] = {0};
+   unsigned semantics[TGSI_SEMANTIC_COUNT];
+   unsigned num_outputs = 0;
+   enum pipe_error error = PIPE_ERROR_OUT_OF_MEMORY;
+
+   assert(mach->ShaderType == MESA_SHADER_COMPUTE);
+   if (!tokens || tgsi_parse_init(&parse, tokens) != TGSI_PARSE_OK)
+      return PIPE_ERROR_BAD_INPUT;
+
+   /* Count first. Exact-size allocations avoid every unchecked realloc in
+    * the legacy binder and leave the machine untouched until commit. */
+   while (!tgsi_parse_end_of_tokens(&parse)) {
+      unsigned index;
+      tgsi_parse_token(&parse);
+      switch (parse.FullToken.Token.Type) {
+      case TGSI_TOKEN_TYPE_DECLARATION: index = 0; break;
+      case TGSI_TOKEN_TYPE_INSTRUCTION: index = 1; break;
+      case TGSI_TOKEN_TYPE_IMMEDIATE: index = 2; break;
+      default: continue;
+      }
+      if (counts[index] == UINT_MAX)
+         goto fail_parse;
+      counts[index]++;
+   }
+   tgsi_parse_free(&parse);
+
+   if (counts[0] > SIZE_MAX / sizeof(*declarations) ||
+       counts[1] > SIZE_MAX / sizeof(*instructions) ||
+       counts[2] > SIZE_MAX / sizeof(*imms))
+      return PIPE_ERROR_OUT_OF_MEMORY;
+   if (counts[0] && !(declarations = MALLOC(counts[0] * sizeof(*declarations))))
+      goto fail;
+   if (counts[1] && !(instructions = MALLOC(counts[1] * sizeof(*instructions))))
+      goto fail;
+   if (counts[2] && !(imms = CALLOC(counts[2], sizeof(*imms))))
+      goto fail;
+   for (unsigned i = 0; i < TGSI_SEMANTIC_COUNT; i++)
+      semantics[i] = ~0u;
+   error = PIPE_ERROR_BAD_INPUT;
+   if (tgsi_parse_init(&parse, tokens) != TGSI_PARSE_OK)
+      goto fail;
+   while (!tgsi_parse_end_of_tokens(&parse)) {
+      tgsi_parse_token(&parse);
+      switch (parse.FullToken.Token.Type) {
+      case TGSI_TOKEN_TYPE_DECLARATION: {
+         const struct tgsi_full_declaration *decl = &parse.FullToken.FullDeclaration;
+         if (used[0] >= counts[0])
+            goto fail_parse;
+         declarations[used[0]++] = *decl;
+         if (decl->Declaration.File == TGSI_FILE_OUTPUT)
+            num_outputs = MAX2(num_outputs, decl->Range.Last + 1);
+         if (decl->Declaration.File == TGSI_FILE_SYSTEM_VALUE) {
+            if (decl->Semantic.Name >= TGSI_SEMANTIC_COUNT ||
+                decl->Range.First >= ARRAY_SIZE(mach->SystemValue))
+               goto fail_parse;
+            semantics[decl->Semantic.Name] = decl->Range.First;
+         }
+         break;
+      }
+      case TGSI_TOKEN_TYPE_INSTRUCTION:
+         if (used[1] >= counts[1])
+            goto fail_parse;
+         instructions[used[1]++] = parse.FullToken.FullInstruction;
+         break;
+      case TGSI_TOKEN_TYPE_IMMEDIATE: {
+         const unsigned nr_tokens = parse.FullToken.FullImmediate.Immediate.NrTokens;
+         if (nr_tokens < 1 || nr_tokens > 5 || used[2] >= counts[2])
+            goto fail_parse;
+         const unsigned size = nr_tokens - 1;
+         for (unsigned i = 0; i < size; i++)
+            imms[used[2]][i] = parse.FullToken.FullImmediate.u[i].Float;
+         used[2]++;
+         break;
+      }
+      default:
+         break; /* Compute properties are consumed by the driver scanner. */
+      }
+   }
+   tgsi_parse_free(&parse);
+   if (memcmp(used, counts, sizeof(counts)))
+      goto fail;
+
+   FREE(mach->Declarations);
+   FREE(mach->Instructions);
+   FREE(mach->Imms);
+   mach->Declarations = declarations;
+   mach->NumDeclarations = counts[0];
+   mach->Instructions = instructions;
+   mach->NumInstructions = counts[1];
+   mach->Imms = imms;
+   mach->ImmsReserved = mach->ImmLimit = counts[2];
+   mach->NumOutputs = num_outputs;
+   memcpy(mach->SysSemanticToIndex, semantics, sizeof(semantics));
+   mach->Tokens = tokens;
+   mach->Sampler = sampler;
+   mach->Image = image;
+   mach->Buffer = buffer;
+   return PIPE_OK;
+
+fail_parse:
+   tgsi_parse_free(&parse);
+fail:
+   FREE(declarations);
+   FREE(instructions);
+   FREE(imms);
+   return error;
+}
+#endif
 
