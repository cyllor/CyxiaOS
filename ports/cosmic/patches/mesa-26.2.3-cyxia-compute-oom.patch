 void
 softpipe_launch_grid(struct pipe_context *context,
                      const struct pipe_grid_info *info)
 {
+#ifdef CYXIA_COMPUTE_OOM
+   struct softpipe_context *softpipe = softpipe_context(context);
+   const struct sp_compute_shader *cs = softpipe->cs;
+   struct tgsi_exec_machine **machines = NULL;
+   void *local_mem = NULL;
+   unsigned initialized = 0;
+   enum pipe_error error = PIPE_OK;
+   uint32_t grid_size[3] = {0};
+   unsigned block[3];
+   unsigned invocations = 1;
+   const struct pipe_compute_caps *caps = &context->screen->compute_caps;
+   const unsigned block_properties[3] = {
+      TGSI_PROPERTY_CS_FIXED_BLOCK_WIDTH, TGSI_PROPERTY_CS_FIXED_BLOCK_HEIGHT,
+      TGSI_PROPERTY_CS_FIXED_BLOCK_DEPTH
+   };
+
+   /* This profile requires the state tracker error sink on every context;
+    * debug flags and reset-notification modes cannot disable GL errors. */
+   assert(context->cyxia_compute_error);
+   if (!cs || !cs->tokens)
+      goto bad_input;
+   if (!fill_grid_size(context, info, grid_size))
+      goto out_of_memory;
+   if (!grid_size[0] || !grid_size[1] || !grid_size[2])
+      return;
+   for (unsigned i = 0; i < 3; i++) {
+      block[i] = cs->info.properties[block_properties[i]];
+      if (!block[i] || block[i] > caps->max_block_size[i] ||
+          grid_size[i] > caps->max_grid_size[i] ||
+          block[i] > INT_MAX || grid_size[i] > INT_MAX ||
+          invocations > caps->max_threads_per_block / block[i])
+         goto bad_input;
+      invocations *= block[i];
+   }
+   size_t count = ((size_t)block[0] + TGSI_QUAD_SIZE - 1) / TGSI_QUAD_SIZE;
+   if (count > INT_MAX / block[1])
+      goto out_of_memory;
+   count *= block[1];
+   if (count > INT_MAX / block[2])
+      goto out_of_memory;
+   count *= block[2];
+   if (count > SIZE_MAX / sizeof(*machines))
+      goto out_of_memory;
+   const uint64_t shared_size = (uint64_t)cs->shader.static_shared_mem +
+                               info->variable_shared_mem;
+   if (shared_size > caps->max_local_size || shared_size > UINT_MAX ||
+       shared_size > SIZE_MAX)
+      goto bad_input;
+   if (shared_size && !(local_mem = CALLOC(1, (size_t)shared_size)))
+      goto out_of_memory;
+   machines = CALLOC(count, sizeof(*machines));
+   if (!machines)
+      goto out_of_memory;
+
+   softpipe_update_compute_samplers(softpipe);
+   for (unsigned z = 0; z < block[2]; z++) {
+      for (unsigned y = 0; y < block[1]; y++) {
+         for (unsigned x = 0; x < block[0]; x += TGSI_QUAD_SIZE) {
+            struct tgsi_exec_machine *machine =
+               tgsi_exec_machine_create(MESA_SHADER_COMPUTE);
+            if (!machine)
+               goto out_of_memory;
+            machines[initialized++] = machine;
+            machine->LocalMem = local_mem;
+            machine->LocalMemSize = shared_size;
+            machine->NonHelperMask =
+               (1 << MIN2(TGSI_QUAD_SIZE, block[0] - x)) - 1;
+            error = cs_prepare(cs, machine, x, y, z,
+                               grid_size[0], grid_size[1], grid_size[2],
+                               block[0], block[1], block[2],
+                               (struct tgsi_sampler *)softpipe->tgsi.sampler[MESA_SHADER_COMPUTE],
+                               (struct tgsi_image *)softpipe->tgsi.image[MESA_SHADER_COMPUTE],
+                               (struct tgsi_buffer *)softpipe->tgsi.buffer[MESA_SHADER_COMPUTE]);
+            if (error != PIPE_OK)
+               goto cleanup;
+            tgsi_exec_set_constant_buffers(machine, PIPE_MAX_CONSTANT_BUFFERS,
+                                           softpipe->mapped_constants[MESA_SHADER_COMPUTE]);
+         }
+      }
+   }
+
+   /* Commit: no workgroup or image/buffer store ran during allocation. */
+   for (unsigned z = 0; z < grid_size[2]; z++)
+      for (unsigned y = 0; y < grid_size[1]; y++)
+         for (unsigned x = 0; x < grid_size[0]; x++)
+            run_workgroup(cs, x, y, z, initialized, machines);
+   if (softpipe->active_statistics_queries)
+      softpipe->pipeline_statistics.cs_invocations +=
+         (uint64_t)grid_size[0] * grid_size[1] * grid_size[2];
+   goto cleanup;
+
+out_of_memory:
+   error = PIPE_ERROR_OUT_OF_MEMORY;
+   goto cleanup;
+bad_input:
+   error = PIPE_ERROR_BAD_INPUT;
+cleanup:
+   for (unsigned i = 0; i < initialized; i++)
+      tgsi_exec_machine_destroy(machines[i]);
+   FREE(machines);
+   FREE(local_mem);
+   if (error != PIPE_OK)
+      context->cyxia_compute_error(context->cyxia_compute_error_data, error);
+#else
    struct softpipe_context *softpipe = softpipe_context(context);
    struct sp_compute_shader *cs = softpipe->cs;
    int num_threads_in_group;
@@ -238,4 +360,5 @@
 
    FREE(local_mem);
    FREE(machines);
-}
+#endif
+}
