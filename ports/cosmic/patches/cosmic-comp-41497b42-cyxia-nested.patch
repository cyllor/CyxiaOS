 // SPDX-License-Identifier: GPL-3.0-only
-use std::process::Command;
+use std::{env, path::Path, process::Command};
+
+fn valid_commit(commit: &str) -> bool {
+    commit.len() == 40 && commit.bytes().all(|byte| byte.is_ascii_hexdigit())
+}
+
+fn git_output(directory: &Path, argument: &str) -> Option<String> {
+    let output = Command::new("git")
+        .arg("-C")
+        .arg(directory)
+        .args(["rev-parse", argument])
+        .output()
+        .ok()?;
+    output.status.success().then_some(())?;
+    Some(String::from_utf8(output.stdout).ok()?.trim().to_owned())
+}
+
+fn checkout_commit(directory: &Path) -> Option<String> {
+    // An exported compositor may live inside another Git repository. Its
+    // ancestor's revision is not the compositor's upstream identity.
+    let top = git_output(directory, "--show-toplevel")?;
+    if Path::new(&top).canonicalize().ok()? != directory.canonicalize().ok()? {
+        return None;
+    }
+    let commit = git_output(directory, "HEAD")?;
+    valid_commit(&commit).then_some(commit)
+}
 
 fn main() {
-    if let Ok(output) = Command::new("git").args(["rev-parse", "HEAD"]).output() {
-        let git_hash = String::from_utf8(output.stdout).unwrap();
-        println!("cargo:rustc-env=GIT_HASH={}", git_hash);
-    }
+    println!("cargo:rerun-if-env-changed=CYXIA_COSMIC_UPSTREAM_COMMIT");
+    let commit = match env::var("CYXIA_COSMIC_UPSTREAM_COMMIT") {
+        Ok(commit) => {
+            assert!(
+                valid_commit(&commit),
+                "CYXIA_COSMIC_UPSTREAM_COMMIT must be exactly 40 hex digits"
+            );
+            commit
+        }
+        Err(env::VarError::NotPresent) => env::var_os("CARGO_MANIFEST_DIR")
+            .and_then(|directory| checkout_commit(Path::new(&directory)))
+            .unwrap_or_else(|| "unknown".to_owned()),
+        Err(env::VarError::NotUnicode(_)) => {
+            panic!("CYXIA_COSMIC_UPSTREAM_COMMIT must be ASCII hex")
+        }
+    };
+    println!("cargo:rustc-env=GIT_HASH={commit}");
 }
