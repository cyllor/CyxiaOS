@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Feature-aware selection, shared by normal startup and host regression tests.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum Backend {
+    #[cfg(feature = "backend-x11")]
+    X11,
+    #[cfg(feature = "backend-winit")]
+    Winit,
+    #[cfg(feature = "backend-kms")]
+    Kms,
+}
+
+pub(super) fn candidates(
+    requested: Option<&str>,
+    nested: bool,
+) -> Result<&'static [Backend], &'static str> {
+    if let Some(requested) = requested {
+        return match requested {
+            #[cfg(feature = "backend-x11")]
+            "x11" => Ok(&[Backend::X11]),
+            #[cfg(feature = "backend-winit")]
+            "winit" => Ok(&[Backend::Winit]),
+            #[cfg(feature = "backend-kms")]
+            "kms" => Ok(&[Backend::Kms]),
+            "x11" | "winit" | "kms" => Err("Requested COSMIC backend is disabled at build time"),
+            _ => Err("Unknown COSMIC_BACKEND value"),
+        };
+    }
+    if nested {
+        let candidates: &'static [Backend] = &[
+            #[cfg(feature = "backend-x11")]
+            Backend::X11,
+            #[cfg(feature = "backend-winit")]
+            Backend::Winit,
+        ];
+        return if candidates.is_empty() {
+            Err("No nested COSMIC backend is enabled")
+        } else {
+            Ok(candidates)
+        };
+    }
+    #[cfg(feature = "backend-kms")]
+    {
+        Ok(&[Backend::Kms])
+    }
+    #[cfg(not(feature = "backend-kms"))]
+    {
+        Err("Nested COSMIC requires DISPLAY or WAYLAND_DISPLAY")
+    }
+}
