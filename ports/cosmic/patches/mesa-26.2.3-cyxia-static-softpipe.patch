--- a/meson.options
+++ b/meson.options
@@ -915,3 +915,10 @@
   value : false,
   description : 'Build panfrost Rust components.'
 )
+
+# CyxiaOS has a Linux userspace personality, but no KMS/DRM or dynamic loader.
+# This opt-in profile builds genuine Mesa software implementations statically.
+option('cyxia-static-softpipe', type : 'boolean', value : false,
+       description : 'CyxiaOS static EGL/GLES softpipe-only port')
+option('cyxia-probe-source', type : 'string', value : '',
+       description : 'Explicit CyxiaOS foundation probe source (empty disables)')
--- a/meson.build
+++ b/meson.build
@@ -159,7 +159,14 @@
 
 with_any_opengl = with_opengl or with_gles1 or with_gles2
 
