+cyxia_static_softpipe = get_option('cyxia-static-softpipe')
+# The target triple describes the musl ABI, not the kernel's device ABI.
+system_has_kms_drm = not cyxia_static_softpipe and ['openbsd', 'netbsd', 'freebsd', 'gnu/kfreebsd', 'dragonfly', 'linux', 'sunos', 'android', 'managarm'].contains(host_machine.system())
+if cyxia_static_softpipe
+  assert(get_option('gallium-drivers') == ['softpipe'], 'Cyxia static profile supports softpipe only')
+  assert(get_option('vulkan-drivers').length() == 0, 'Cyxia static profile has no Vulkan device backend')
+  assert(get_option('glx') == 'disabled' and get_option('gbm').disabled(), 'Cyxia static profile requires GLX and GBM disabled')
+endif
 
