+impl State {
+    pub(crate) fn accept_session_lock(&mut self, locker: SessionLocker) {
+        if !locker.ext_session_lock().is_alive() { return; }
+        let mut shell = self.common.shell.write();
+
+        // Reject lock if sesion lock exists and is still valid
+        if let Some(session_lock) = shell.session_lock.as_ref()
+            && session_lock.ext_session_lock != *locker.ext_session_lock()
+            && session_lock.ext_session_lock.is_alive()
+            && self
+                .common
+                .display_handle
+                .get_client(session_lock.ext_session_lock.id())
+                .is_ok()
+        {
+            return;
+        }
+
+        let ext_session_lock = locker.ext_session_lock().clone();
+        locker.lock();
+        // Native blanking already installed an internal barrier and may
+        // have configured lock surfaces before the public locked event.
+        if shell.session_lock.as_ref().is_none_or(|lock| lock.ext_session_lock != ext_session_lock) {
+            shell.session_lock = Some(SessionLock {
+                ext_session_lock,
+                surfaces: HashMap::new(),
+            });
+        }
+
+        for output in shell.outputs() {
+            self.backend.schedule_render(output);
+        }
+    }
