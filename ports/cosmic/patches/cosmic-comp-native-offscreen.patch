+// SPDX-License-Identifier: GPL-3.0-only
+
+use smithay::{
+    output::Output,
+    reexports::wayland_server::{
+        DisplayHandle,
+        protocol::{wl_buffer::WlBuffer, wl_surface::WlSurface},
+    },
+};
+
+/// A capture source and optional destination, independent of the output backend.
+///
+/// KMS resolves these objects to its render/copy devices. Single-renderer
+/// backends use their existing renderer. Callers never inspect KMS state.
+#[derive(Debug, Clone, Copy)]
+pub enum OffscreenTarget<'a> {
+    /// Cursor capture and other rendering without a particular output or surface.
+    Primary,
+    /// Query capture constraints for an output.
+    Output(&'a Output),
+    /// Query capture constraints for the surface's committed buffer.
+    Surface(&'a WlSurface),
+    /// Render an output/workspace to a client's capture buffer.
+    OutputBuffer {
+        output: &'a Output,
+        buffer: &'a WlBuffer,
+    },
+    /// Render a toplevel to a client's capture buffer.
+    SurfaceBuffer {
+        surface: Option<&'a WlSurface>,
+        buffer: &'a WlBuffer,
+    },
+    /// A screenshot uses the device advertised to the surface's client.
+    /// This intentionally differs from the committed-buffer capture constraint.
+    Screenshot {
+        surface: &'a WlSurface,
+        display: &'a DisplayHandle,
+    },
+}
