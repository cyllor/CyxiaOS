+// SPDX-License-Identifier: GPL-3.0-only
+
+/// Device preference after resolving a capture's Wayland objects.
+///
+/// Kept independent of device handles so the KMS selection contract can be
+/// exercised without opening a display device. `None` means the caller must
+/// use its software renderer; it does not create or substitute a GPU device.
+pub enum DevicePreference<Node> {
+    Primary,
+    Output {
+        output: Option<Node>,
+        target: Option<Node>,
+    },
+    Surface {
+        surface: Option<Node>,
+        target: Option<Node>,
+    },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct NodePair<Node> {
+    pub render: Node,
+    pub target: Node,
+}
+
+impl<Node: Copy> DevicePreference<Node> {
+    pub fn select(self, primary: Option<Node>) -> Option<NodePair<Node>> {
+        match self {
+            Self::Primary => primary.map(|node| NodePair {
+                render: node,
+                target: node,
+            }),
+            Self::Output { output, target } => {
+                let render = output.or(primary)?;
+                Some(NodePair {
+                    render,
+                    target: target.unwrap_or(render),
+                })
+            }
+            Self::Surface { surface, target } => {
+                let node = target.or(surface).or(primary)?;
+                Some(NodePair {
+                    render: node,
+                    target: node,
+                })
+            }
+        }
+    }
+}
