+// SPDX-License-Identifier: GPL-3.0-only
+
+use super::{
+    KmsState,
+    offscreen_policy::{DevicePreference, NodePair},
+};
+use crate::{
+    backend::{
+        offscreen::OffscreenTarget,
+        render::{GlMultiError, RendererRef},
+    },
+    state::advertised_node_for_surface,
+};
+use smithay::{
+    backend::{
+        allocator::{Buffer, Fourcc},
+        drm::DrmNode,
+        renderer::{BufferType, buffer_type, utils::with_renderer_surface_state},
+    },
+    reexports::wayland_server::protocol::{wl_buffer::WlBuffer, wl_surface::WlSurface},
+    wayland::{
+        dmabuf::get_dmabuf,
+        shm::{shm_format_to_fourcc, with_buffer_contents},
+    },
+};
+
+fn buffer_node(buffer: &WlBuffer) -> Option<DrmNode> {
+    get_dmabuf(buffer).ok().and_then(|dmabuf| dmabuf.node())
+}
+
+fn surface_node(surface: &WlSurface) -> Option<DrmNode> {
+    with_renderer_surface_state(surface, |state| {
+        let buffer = state.buffer()?;
+        let dmabuf = get_dmabuf(buffer).ok()?;
+        dmabuf.node()
+    })
+    .flatten()
+}
+
+impl KmsState {
+    fn offscreen_nodes(&self, target: OffscreenTarget<'_>) -> Option<(NodePair<DrmNode>, Fourcc)> {
+        let primary = *self.primary_node.read().unwrap();
+        let preference = match target {
+            OffscreenTarget::Primary => DevicePreference::Primary,
+            OffscreenTarget::Output(output) => DevicePreference::Output {
+                output: self.target_node_for_output(output),
+                target: None,
+            },
+            OffscreenTarget::Surface(surface) => DevicePreference::Surface {
+                surface: surface_node(surface),
+                target: None,
+            },
+            OffscreenTarget::OutputBuffer { output, buffer } => DevicePreference::Output {
+                output: self.target_node_for_output(output),
+                target: buffer_node(buffer),
+            },
+            OffscreenTarget::SurfaceBuffer { surface, buffer } => {
+                let target = buffer_node(buffer);
+                DevicePreference::Surface {
+                    surface: if target.is_none() {
+                        surface.and_then(surface_node)
+                    } else {
+                        None
+                    },
+                    target,
+                }
+            }
+            OffscreenTarget::Screenshot { surface, display } => DevicePreference::Surface {
+                surface: advertised_node_for_surface(surface, display),
+                target: None,
+            },
+        };
+        let nodes = preference.select(primary)?;
+        // Only output/workspace capture can copy across devices. Preserve the
+        // destination buffer format, including the upstream ABGR fallback.
+        let copy_format = if let OffscreenTarget::OutputBuffer { buffer, .. } = target {
+            match buffer_type(buffer) {
+                Some(BufferType::Dma) => Some(get_dmabuf(buffer).unwrap().format().code),
+                Some(BufferType::Shm) => {
+                    with_buffer_contents(buffer, |_, _, data| shm_format_to_fourcc(data.format))
+                        .unwrap()
+                }
+                _ => None,
+            }
+        } else {
+            None
+        }
+        .unwrap_or(Fourcc::Abgr8888);
+        Some((nodes, copy_format))
+    }
+
+    pub fn offscreen_renderer(
+        &mut self,
+        target: OffscreenTarget<'_>,
+    ) -> Result<RendererRef<'_>, GlMultiError> {
+        if let Some((nodes, copy_format)) = self.offscreen_nodes(target) {
+            Ok(RendererRef::GlMulti(self.api.renderer(
+                &nodes.render,
+                &nodes.target,
+                copy_format,
+            )?))
+        } else {
+            Ok(RendererRef::Glow(
+                self.software_renderer
+                    .as_mut()
+                    .expect("No Software Rendering"),
+            ))
+        }
+    }
+}
