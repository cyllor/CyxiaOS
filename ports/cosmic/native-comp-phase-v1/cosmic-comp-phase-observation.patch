@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-3.0-only
+//! Once-only observations of genuine work, independent of all runtime gates.
+//!
+//! The clock starts at the first State::new begin marker, not at guest boot or
+//! host launch. These are bounded write attempts; I/O failure loses evidence
+//! and never changes rendering, error propagation or presentation completion.
+use std::{
+    io::Write,
+    sync::{OnceLock, atomic::{AtomicU32, Ordering}},
+    time::Instant,
+};
+
+static SEEN: AtomicU32 = AtomicU32::new(0);
+static ORIGIN: OnceLock<Instant> = OnceLock::new();
+static PID: OnceLock<u32> = OnceLock::new();
+const MAX_RECORD_BYTES: usize = 160;
+
+#[derive(Clone, Copy)]
+#[repr(u32)]
+pub(crate) enum Phase {
+    StateBegin,
+    StateEnd,
+    EglDisplayBegin,
+    EglDisplayEnd,
+    EglContextBegin,
+    EglContextEnd,
+    RendererBegin,
+    RendererEnd,
+    ShadersBegin,
+    ShadersEnd,
+    FirstRenderBegin,
+    FirstRenderEnd,
+    FirstReadbackCopyBegin,
+    FirstReadbackCopyEnd,
+    FirstReadbackMapBegin,
+    FirstReadbackMapEnd,
+    FirstTileSubmitBegin,
+    FirstTileSubmitEnd,
+    FirstFullScanoutComplete,
+}
+
+impl Phase {
+    fn name(self) -> &'static str {
+        match self {
+            Self::StateBegin => "state_begin",
+            Self::StateEnd => "state_end",
+            Self::EglDisplayBegin => "egl_display_begin",
+            Self::EglDisplayEnd => "egl_display_end",
+            Self::EglContextBegin => "egl_context_begin",
+            Self::EglContextEnd => "egl_context_end",
+            Self::RendererBegin => "renderer_begin",
+            Self::RendererEnd => "renderer_end",
+            Self::ShadersBegin => "shaders_begin",
+            Self::ShadersEnd => "shaders_end",
+            Self::FirstRenderBegin => "first_render_begin",
+            Self::FirstRenderEnd => "first_render_end",
+            Self::FirstReadbackCopyBegin => "first_readback_copy_begin",
+            Self::FirstReadbackCopyEnd => "first_readback_copy_end",
+            Self::FirstReadbackMapBegin => "first_readback_map_begin",
+            Self::FirstReadbackMapEnd => "first_readback_map_end",
+            Self::FirstTileSubmitBegin => "first_tile_submit_begin",
+            Self::FirstTileSubmitEnd => "first_tile_submit_end",
+            Self::FirstFullScanoutComplete => "first_full_scanout_complete",
+        }
+    }
+}
+
+/// Return whether this call claimed the event, even if the write fails.
+/// Nineteen closed enum variants permit at most nineteen 160-byte attempts.
+pub(crate) fn mark_once(phase: Phase) -> bool {
+    let bit = 1u32 << (phase as u32);
+    if SEEN.fetch_or(bit, Ordering::Relaxed) & bit != 0 {
+        return false;
+    }
+    let elapsed_ns = ORIGIN.get_or_init(Instant::now).elapsed().as_nanos();
+    let pid = *PID.get_or_init(std::process::id);
+    let mut line = [0u8; MAX_RECORD_BYTES];
+    let mut remaining = &mut line[..];
+    let formatted = writeln!(
+        &mut remaining,
+        "CYXIA_COMP_PHASE_V1 pid={pid} phase={} elapsed_ns={elapsed_ns}",
+        phase.name(),
+    ).is_ok();
+    let length = MAX_RECORD_BYTES - remaining.len();
+    if formatted {
+        let _ = std::io::stderr().lock().write_all(&line[..length]);
+    }
+    true
+}
