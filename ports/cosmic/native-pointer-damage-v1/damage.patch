+    /// Cover every damaged pixel with one clipped bounding rectangle. The full
+    /// readback remains immutable; source rows are still indexed in that full
+    /// mapping, including its global vertical flip. Empty damage conservatively
+    /// preserves the full-frame path. Session-lock black scanout uses `new`.
+    pub fn for_damage(
+        info: DisplayInfo,
+        flipped: bool,
+        damage: impl IntoIterator<Item = (i32, i32, i32, i32)>,
+    ) -> io::Result<Self> {
+        let mut pending = Self::new(info, flipped)?;
+        let mut bounds: Option<(i64, i64, i64, i64)> = None;
+        for (x, y, width, height) in damage {
+            if width < 0 || height < 0 {
+                return Err(invalid("invalid native damage extent"));
+            }
+            let left = i64::from(x).max(0);
+            let top = i64::from(y).max(0);
+            let right = (i64::from(x) + i64::from(width)).min(i64::from(info.width));
+            let bottom = (i64::from(y) + i64::from(height)).min(i64::from(info.height));
+            if left >= right || top >= bottom {
+                continue;
+            }
+            bounds = Some(match bounds {
+                None => (left, top, right, bottom),
+                Some((a, b, c, d)) => (a.min(left), b.min(top), c.max(right), d.max(bottom)),
+            });
+        }
+        if let Some((left, top, right, bottom)) = bounds {
+            pending.region = Rectangle {
+                x: left as u32,
+                y: top as u32,
+                width: (right - left) as u32,
+                height: (bottom - top) as u32,
+            };
+        }
+        Ok(pending)
     }
 
