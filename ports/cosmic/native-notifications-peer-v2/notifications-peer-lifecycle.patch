+/// Own the optional peer independently of the public notifications bus.
+/// Dropping Conns also cancels an idle peer and releases its socket.
+#[derive(Debug)]
+pub struct PanelTask(tokio::task::JoinHandle<()>);
+
+impl PanelTask {
+    pub fn spawn(tx: Sender<Input>) -> Self {
+        Self(tokio::spawn(async move {
+            match setup_panel_conn(tx).await {
+                Ok(conn) => {
+                    info!("Created panel dbus server");
+                    std::future::pending::<()>().await;
+                    drop(conn);
+                }
+                Err(err) => error!("Failed to setup panel dbus server {}", err),
+            }
+        }))
+    }
+}
+
+impl Drop for PanelTask {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
