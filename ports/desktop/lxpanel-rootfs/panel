# CyxiaOS desktop profile: upstream LXPanel menu and window controls.
Global {
    edge=bottom
    align=left
    margin=0
    widthtype=percent
    width=100
    height=32
    transparent=0
    tintcolor=#202a3b
    alpha=255
    setdocktype=1
    setpartialstrut=1
    usefontcolor=0
    fontcolor=#ffffff
    background=0
    iconsize=22
}
Plugin {
    type=menu
    Config {
        image=/usr/share/lxpanel/images/my-computer.png
        item {
            name=Files
            image=/usr/share/libfm/images/folder.png
            action=pcmanfm /
        }
        item {
            name=Terminal
            action=cyxia-terminal
        }
        separator {
        }
        item {
            name=Save Files
            action=cyxia-save
        }
    }
}
Plugin {
    type=wincmd
    Config {
        Button1=iconify
        Button2=shade
        Toggle=1
        image=/usr/share/lxpanel/images/gnome-fs-desktop.png
    }
}
Plugin {
    type=pager
}
Plugin {
    type=taskbar
    expand=1
    Config {
        tooltips=1
        IconsOnly=0
        ShowIconified=1
        ShowMapped=1
        ShowAllDesks=0
        ShowSquareBrackets=1
        UseMouseWheel=1
        UseUrgencyHint=1
        FlatButton=0
        MaxTaskWidth=180
        spacing=2
    }
}
Plugin {
    type=dclock
    Config {
        ClockFmt=%R UTC
        TooltipFmt=%A %x UTC
        BoldFont=0
    }
}
