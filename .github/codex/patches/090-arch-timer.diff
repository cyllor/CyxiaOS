-//! Arm generic physical timer. Caller owns the EL1 physical timer and IRQ.
+//! Arm generic physical timer plus the prototype's per-vCPU PMU accounting clock.
+//!
+//! `ticks()` is the shared monotonic time source used for deadlines, leases and
+//! timer programming. `cpu_ticks()` is intentionally separate: the locked QEMU
+//! platform supplies a per-vCPU PMCCNTR_EL0 source and it is used only to debit
+//! actual CPU execution. Mixing the two would charge time spent descheduled by
+//! another vCPU to the current task.
 use core::arch::asm;
+
+/// Frequency of the generic physical timer used for monotonic time.
 pub fn frequency() -> u64 {
     let x;
-    unsafe { asm!("mrs {}, cntfrq_el0",out(reg)x) }
+    unsafe { asm!("mrs {}, cntfrq_el0", out(reg) x) }
     x
 }
+
+/// Shared monotonic physical-timer ticks. This is not a per-vCPU CPU clock.
 pub fn ticks() -> u64 {
     let x;
-    unsafe { asm!("isb","mrs {}, cntpct_el0",out(reg)x) }
+    unsafe { asm!("isb", "mrs {}, cntpct_el0", out(reg) x) }
     x
 }
+
+/// The locked prototype platform exposes PMCCNTR as a 1 GHz per-vCPU counter.
+pub const fn cpu_frequency() -> u64 {
+    1_000_000_000
+}
+
+/// Convert a per-vCPU PMU delta into nanoseconds without using the wall clock.
+pub fn cpu_ns(delta: u64) -> u64 {
+    ((u128::from(delta) * 1_000_000_000) / u128::from(cpu_frequency()))
+        .min(u128::from(u64::MAX)) as u64
+}
+
+/// Read the current CPU's execution counter.
+pub fn cpu_ticks() -> u64 {
+    let x;
+    unsafe { asm!("isb", "mrs {}, pmccntr_el0", out(reg) x) }
+    x
+}
+
+/// Enable the 64-bit cycle counter for this CPU.
+///
+/// # Safety
+/// The caller must run once during EL1 bring-up on the CPU being initialized.
+/// The locked prototype QEMU must provide the CyxiaOS per-vCPU PMU timing patch;
+/// stock QEMU's global virtual PMU clock is not a valid CPU-accounting source.
+pub unsafe fn init_cpu_accounting() {
+    let mut pmcr: u64;
+    unsafe {
+        asm!("mrs {}, pmcr_el0", out(reg) pmcr);
+    }
+    // E: enable all PMU counters, C: reset cycle counter, LC: 64-bit PMCCNTR.
+    pmcr |= (1 << 0) | (1 << 2) | (1 << 6);
+    unsafe {
+        asm!(
+            "msr pmccfiltr_el0, xzr",
+            "msr pmcr_el0, {pmcr}",
+            "mov x9, #1",
+            "lsl x9, x9, #31",
+            "msr pmcntenset_el0, x9",
+            "isb",
+            pmcr = in(reg) pmcr,
+            out("x9") _,
+        );
+    }
+}
+
 /// # Safety
 /// Caller owns the physical timer interrupt and has installed its handler.
 pub unsafe fn arm(deadline: u64) {
     unsafe {
-        asm!("msr cntp_cval_el0, {}","mov x9, #1","msr cntp_ctl_el0, x9","isb",in(reg)deadline,out("x9")_)
+        asm!(
+            "msr cntp_cval_el0, {}",
+            "mov x9, #1",
+            "msr cntp_ctl_el0, x9",
+            "isb",
+            in(reg) deadline,
+            out("x9") _
+        )
     }
 }
+
 /// # Safety
 /// Exception vectors and device state must be ready for IRQ entry.
 pub unsafe fn enable_irqs() {
     unsafe { asm!("msr daifclr, #2", "isb") }
 }
+
 pub fn idle() {
     unsafe { asm!("wfi") }
 }
