--- a/tools/check_v13_preparation_stack.py
+++ b/tools/check_v13_preparation_stack.py
@@ -133,6 +133,20 @@ def frame_size(code):
             size += int(pushed[1], 0)
             allocations.add(address)
             continue
+        # LLVM can fold a fixed 16-byte decrement into a post-index STR.
+        # Its store address uses the old SP, but the following frame begins
+        # at SP-offset. Charge the writeback, never silently ignore it.
+        post_store = re.fullmatch(
+            r"(?:[xw](?:[0-9]|[12][0-9]|30)|[xw]zr), \[sp\], #-(0x[0-9a-f]+|[0-9]+)",
+            operands,
+        )
+        if opcode == "str" and post_store:
+            decrement = int(post_store[1], 0)
+            if decrement == 0 or decrement > 256 or decrement % 16:
+                raise ValueError("unrecognized post-index stack allocation")
+            size += decrement
+            allocations.add(address)
+            continue
         if opcode == "b.ne" and probe is not None:
             destination = int(operands.split()[0], 16)
             if destination >= address or probe < size:
diff --git a/tools/test_check_v13_preparation_stack.py b/tools/test_check_v13_preparation_stack.py
index b0dee51..5180fa8 100644
--- a/tools/test_check_v13_preparation_stack.py
+++ b/tools/test_check_v13_preparation_stack.py
@@ -63,6 +63,26 @@ class PreparationStackTests(unittest.TestCase):
         code = next(iter(instructions(text).values()))
         self.assertEqual(frame_size(code), 30688)
 
+    def test_post_index_store_charges_exact_sp_writeback(self):
+        for reg, offset in [("xzr", "0x10"), ("x19", "32"), ("wzr", "0x100")]:
+            code = [(0x1000, "sub", "sp, sp, #16"),
+                    (0x1004, "str", f"{reg}, [sp], #-{offset}"),
+                    (0x1008, "bl", "0x2000"),
+                    (0x100c, "add", f"sp, sp, #{16 + int(offset, 0)}"),
+                    (0x1010, "ret", "")]
+            self.assertEqual(frame_size(code), 16 + int(offset, 0))
+
+    def test_post_index_store_cannot_hide_late_or_dynamic_growth(self):
+        with self.assertRaisesRegex(ValueError, "stack write"):
+            frame_size([(0x1000, "sub", "sp, sp, #16"),
+                        (0x1004, "bl", "0x2000"),
+                        (0x1008, "str", "xzr, [sp], #-0x10")])
+        for operand in ["xzr, [sp], #-8", "xzr, [sp], #-0x200",
+                        "xzr, [sp], #0x10", "xzr, [sp], #-0", "xzr, [sp], #x8"]:
+            with self.subTest(operand=operand), self.assertRaises(ValueError):
+                frame_size([(0x1000, "sub", "sp, sp, #16"),
+                            (0x1004, "str", operand), (0x1008, "bl", "0x2000")])
+
     def test_missing_edges_and_dynamic_prologues_fail_closed(self):
         with self.assertRaisesRegex(ValueError, "missing direct preparation path"):
             inspect(chain(False).replace("bl 0x4000", "bl 0x8000")
